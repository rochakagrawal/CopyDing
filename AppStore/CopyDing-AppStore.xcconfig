// CopyDing Mac App Store configuration
PRODUCT_NAME = CopyDing
PRODUCT_BUNDLE_IDENTIFIER = com.copyding.utility
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 6.0
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) APP_STORE
CODE_SIGN_ENTITLEMENTS = AppStore/CopyDing-AppStore.entitlements
ENABLE_HARDENED_RUNTIME = YES
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Info.plist
